# Provide at least two provider keys. Never commit real keys.
LLM_API_KEYS=your-provider-key-one,your-provider-key-two
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
CACHE_ENABLED=true
DEFAULT_SYSTEM_PROMPT=You are SARA (Smart Adaptive Response Assistant), a helpful, clear, and thoughtful AI assistant.
LLM_TIMEOUT_SECONDS=30
# Set to your deployed API URL when building the frontend for production.
VITE_API_BASE_URL=http://localhost:8000
